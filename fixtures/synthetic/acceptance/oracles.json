    "stdinUtf8": "",
    "expectedStdout": "T|true:true:1:2\n"
  },
  {
    "id": "conditions-false",
    "method": "conditions",
    "expression": "first ? effects++ : ++effects",
    "argv": ["conditions", "false"],
    "stdinUtf8": "",
    "expectedStdout": "T|false:true:2:2\n"
  },
  {
    "id": "strings",
    "method": "strings",
