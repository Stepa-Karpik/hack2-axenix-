# Local settings. The launchers create a private .env copy and generate missing secrets.
# API and workbench are local-only; never place server secrets in VITE_* variables.
JB_BIND_HOST=127.0.0.1
JB_API_PORT=8081
JB_DB_HOST=127.0.0.1
JB_DB_PORT=55433
JB_DB_NAME=java_blueprints
JB_DB_USER=java_blueprints
JB_DB_PASSWORD=replace_with_local_random_secret
# Native API execution is disabled unless a trusted Linux controller is configured.
# Compose supplies its own private runner URL and enables execution automatically.
JB_RUNNER_ENABLED=false
JB_RUNNER_CONTROLLER_URL=http://127.0.0.1:8091
JB_RUNNER_CONTROLLER_TOKEN=
JB_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081
# Optional portable Node/pnpm directories; otherwise tools must be on PATH.
JB_NODE_HOME=
JB_PNPM_HOME=
# Account email delivery: smtp.yandex.ru uses implicit TLS port 465 and an app password.
# Username and From must be the same full Yandex mailbox address.
# https://yandex.ru/support/yandex-360/customers/mail/ru/mail-clients/others
# Leave blank to expose email delivery as unavailable. No credentials belong in VITE_*.
JB_SMTP_HOST=
JB_SMTP_PORT=
JB_SMTP_USERNAME=
JB_SMTP_PASSWORD=
JB_SMTP_FROM=
JB_PUBLIC_URL=

# Optional GitHub OAuth App. Server-only, never VITE_*.
JB_GITHUB_CLIENT_ID=
JB_GITHUB_CLIENT_SECRET=
# Base64 of32 random bytes; encrypts repository tokens at rest.
JB_GITHUB_TOKEN_KEY=
JB_GITHUB_CALLBACK_URL=http://127.0.0.1:5174/api/v1/github/oauth/callback

# Explicit hosting mode is disabled for local development.
JB_HOSTING_ENABLED=false
JB_SESSION_COOKIE_SECURE=false

# Optional assistant: server-only, never VITE_*.
DEEPSEEK_API_KEY=
JB_DEEPSEEK_MODEL=deepseek-flash
